PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-store.example

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT
# Use a cryptographically random value of at least 32 characters in production.
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# Email
# Gmail: smtp.gmail.com, port 587, secure false; use an App Password, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Email Queue
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_QUEUE_ENCRYPTION_KEY=
# Random secret sent as Authorization: Bearer by Vercel Cron when CRON_SECRET is configured.
CRON_SECRET=
# Set to the number of trusted reverse proxies in front of Express (usually 1 on Vercel).
TRUST_PROXY_HOPS=0
# Comma-separated operator-maintained disposable email domains; use a maintained screening provider for broad coverage.
DISPOSABLE_EMAIL_DOMAINS=
